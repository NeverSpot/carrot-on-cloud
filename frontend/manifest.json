{
  "name": "Carrot-On-Cloud",
  "description": "Real-time Codeforces rating predictions — compute once, serve instant. Reduces CF API load by 40,000x.",
  "version": "1.1.0",
  "manifest_version": 3,
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "https://trexoycbvrfivjkwreea.supabase.co/*"
  ],
  "action":{
    "default_popup":"./popup/popup.html",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "js": ["scripts/content.js"],
      "css": ["scripts/content.css"],
      "matches": [
        "https://codeforces.com/contest/*/standings*"
      ],
      "run_at": "document_idle"
    }
  ]

}